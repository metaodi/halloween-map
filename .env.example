# Supabase-Projekt (Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Nur lokal/Build: Basis-Pfad (GitHub Pages setzt ihn im Workflow), Default "/"
# VITE_BASE=/halloween-map/

# Slug des Orts, der ohne ?ort=… angezeigt wird (leer = Ort-Auswahlseite)
VITE_DEFAULT_VILLAGE=pfnuselkueste

# Geocoder: "swisstopo" (Default) oder "photon"
VITE_GEOCODER=swisstopo
